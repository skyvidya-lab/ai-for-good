## Cell 5 — Dynamis: MKM + ChaosAttention + Region Embedding
"""

import copy, torch, torch.nn as nn, torch.nn.functional as F, math
from torch.utils.data import DataLoader, TensorDataset, WeightedRandomSampler

try:
